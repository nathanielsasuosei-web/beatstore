# ═══════════════════════════════════════════════════════════════
#  NSO Beats — environment variables
#
#  HOW TO USE THIS FILE
#    1. Copy it:   cp .env.example .env
#    2. Fill in the blanks you have today (see TIER 1 and TIER 2 below)
#    3. Restart the dev server:  npm run dev
#
#  You do NOT need Paystack or Resend to try the whole store. With those
#  two blank the site runs in demo mode: a built-in test checkout stands in
#  for the card/momo screen, and every email is still written and readable
#  in Admin → Email outbox. Add the keys when you're ready to go live.
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
#  TIER 1 — required, takes 30 seconds
# ───────────────────────────────────────────────────────────────

# Where the data lives. SQLite needs no server and no signup; the file is
# created by `npm run db:setup`. (For a busy production site, swap this for
# a Postgres URL — see the deployment section of README.md.)
DATABASE_URL="file:./dev.db"

# Signs the login cookie for artists and for you. Paste the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anyone who knows this value can forge a login, so keep it secret and use a
# different one on your live site than on your laptop.
AUTH_SECRET="change-me-to-a-long-random-string"

# Your site's public address. Used to build the links inside emails
# (download links, licence PDFs) and to send Paystack back to your store
# after a payment. Local while developing, your real domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ───────────────────────────────────────────────────────────────
#  TIER 2 — take real payments and send real emails
# ───────────────────────────────────────────────────────────────

# ── Paystack ── mobile money (MTN / Telecel / AT), bank, card ───
# Dashboard → Settings → API Keys & Webhooks
#   https://dashboard.paystack.com/#/settings/developers
# Use the test keys first (they start with pk_test_ / sk_test_) with a
# Paystack test mobile-money number, then swap in the live keys when the
# flow looks right. Leave PAYSTACK_SECRET_KEY EMPTY to keep the built-in
# test checkout instead.
#
# One more step after you deploy: in that same dashboard page, set the
# Webhook URL to  https://YOUR-DOMAIN.com/api/webhooks/paystack
# That is how Paystack tells the store "this payment succeeded" when the
# buyer finishes paying on their phone. Without it, orders stay pending
# until you mark them paid by hand.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ── Resend ── sends the beats, receipts and notifications ───────
# Create a key at https://resend.com/api-keys  (this is a secret, not the
# NEXT_PUBLIC_ kind). Leave it empty and the store stays fully usable:
# emails are rendered and saved to the admin Outbox, just not delivered.
RESEND_API_KEY=""

# The "From" address on every email. Until you verify your own domain in
# Resend, their sandbox sender below is the only one that works. Once your
# domain is verified, use something like "NSO Beats <beats@yourdomain.com>".
EMAIL_FROM="NSO Beats <onboarding@resend.dev>"

# Where you want the money alerts to land: "New order started",
# "Payment submitted — please verify", etc. Use your real inbox.
# Leave blank and admin alerts simply won't be sent (they still appear in
# the admin Outbox).
ADMIN_NOTIFICATION_EMAIL=""


# ───────────────────────────────────────────────────────────────
#  TIER 3 — you can normally leave these exactly as they are
# ───────────────────────────────────────────────────────────────

# Folder where uploaded beats, covers, previews and videos are written.
# It is git-ignored; on a host with ephemeral disk, back this with a volume
# or swap in S3-style storage (README.md explains when and why).
STORAGE_DIR="storage"

# Lets the demo "Pay / I've sent it" buttons work without Paystack keys.
# Turn this OFF once real keys are in ("false") — never leave it on in
# production, or visitors could mark their own orders as paid.
ENABLE_PAYMENT_SIMULATION="true"
