# ─────────────────────────────────────────────────────────────
# Beatstore environment variables
# Copy this file to `.env` and fill in what you have.
# Everything below is optional except DATABASE_URL + AUTH_SECRET —
# the store runs in demo mode without payment/email credentials.
# ─────────────────────────────────────────────────────────────

# Database (SQLite by default — zero setup).
DATABASE_URL="file:./dev.db"

# Signing secret for login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used in emailed links + Paystack callback).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Payments: Paystack (mobile money, bank, card) ────────────
# Get these from https://dashboard.paystack.com/#/settings/developers
# Leave PAYSTACK_SECRET_KEY empty to keep the built-in test checkout.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ── Email: Resend ────────────────────────────────────────────
# Get a key at https://resend.com/api-keys
# Leave RESEND_API_KEY empty to use the admin "Outbox" preview mode
# (every email is still rendered and stored, it just isn't delivered).
RESEND_API_KEY=""
EMAIL_FROM="NSO Beats <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL=""

# ── Uploads ──────────────────────────────────────────────────
# Where uploaded beats/covers/videos are stored on disk.
STORAGE_DIR="storage"

# Set to "true" only if you want the test checkout enabled while a
# real Paystack key is configured (never do this in production).
ENABLE_PAYMENT_SIMULATION="true"
